{
  "name": "@buzzprep/server",
  "version": "0.1.0",
  "private": true,
  "description": "buZZprep API, scheduler and Web Push dispatcher (Express + MongoDB).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "vapid:generate": "tsx scripts/generate-vapid.ts",
    "config:import": "tsx scripts/import-config.ts",
    "password:reset": "tsx scripts/reset-password.ts",
    "password:link": "tsx scripts/reset-link.ts"
  },
  "dependencies": {
    "@buzzprep/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "mongoose": "^9.12.1",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
