# ─────────────────────────────────────────────────────────────────────────────
# buZZprep configuration. Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Where people open the app. Your subdomain goes here.
APP_DOMAIN=prep.example.com
PUBLIC_APP_URL=https://prep.example.com

# Random secret for sessions and notification tokens (32+ characters):
#   openssl rand -base64 48
SESSION_SECRET=

# Who can create accounts: open | invite | closed.
#   invite: everyone needs INVITE_CODE, including the first account (recommended).
#   closed: only the very first account can be created; nobody after it.
# The first account on a new server becomes its owner (admin).
#   Invite code:  openssl rand -hex 16
REGISTRATION_MODE=invite
INVITE_CODE=

# Web Push keys. Generate once:  npm run vapid:generate
# (or, with Docker: docker compose run --rm --no-deps app node apps/server/dist/generate-vapid.js)
# Changing them later invalidates every device subscription. Set all three, or none
# (reminders are then off). VAPID_SUBJECT is a contact for push services,
# e.g. mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# MongoDB credentials used by docker-compose.yml.
MONGO_ROOT_USER=buzzprep
MONGO_ROOT_PASSWORD=

# Start Caddy (automatic HTTPS). Remove to use your own reverse proxy.
COMPOSE_PROFILES=caddy

# ── Optional ────────────────────────────────────────────────────────────────
# APP_ROLE=all                # all | api | worker (split scheduler into its own container)
# SCHEDULER_TICK_SECONDS=15
# NOTIFICATION_HORIZON_HOURS=36
# LOG_LEVEL=info
# APP_PORT=4000               # host port bound to 127.0.0.1

# ── Local development (npm run dev) ─────────────────────────────────────────
# PUBLIC_APP_URL=http://localhost:5173
# MONGODB_URI=mongodb://127.0.0.1:27017/buzzprep
# REGISTRATION_MODE=open
