# ─────────────────────────────────────────────────────────────────────────────
# buZZprep configuration. Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Where people open the app. Your subdomain goes here.
APP_DOMAIN=prep.example.com
PUBLIC_APP_URL=https://prep.example.com

# Random secret for sessions and notification tokens (32+ characters):
#   openssl rand -base64 48
SESSION_SECRET=

# Who can create accounts: open | invite | closed.
#   invite: everyone needs INVITE_CODE, including the first account (recommended).
#   closed: only the very first account can be created; nobody after it.
# The first account on a new server becomes its owner (admin).
#   Invite code:  openssl rand -hex 16
REGISTRATION_MODE=invite
INVITE_CODE=

# Web Push keys. Generate once:  npm run vapid:generate
# (or, with Docker: docker compose run --rm --no-deps app node apps/server/dist/generate-vapid.js)
# Changing them later invalidates every device subscription. Set all three, or none
# (reminders are then off). VAPID_SUBJECT is a contact for push services,
# e.g. mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# MongoDB credentials used by docker-compose.yml.
MONGO_ROOT_USER=buzzprep
MONGO_ROOT_PASSWORD=

# Start Caddy (automatic HTTPS). Remove to use your own reverse proxy.
COMPOSE_PROFILES=caddy

# ── Email (optional) ────────────────────────────────────────────────────────
# Lets "Forgot your password?" email a one-time reset link. Without it, make links
# on the server:  npm run password:link -- --email you@example.com
# e.g. SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
# e.g. MAIL_FROM=buZZprep <no-reply@prep.example.com>
MAIL_FROM=

# ── Journal AI (optional) ───────────────────────────────────────────────────
# Voice logs are transcribed and turned into revision notes by a cloud AI provider.
# With no keys the journal still works: typed logs, your own notes and the weekly
# revision sheet. Keys stay on the server; the browser never sees them.
# Each person can still turn AI off for their own journal in the app.
#
# One key is enough: put it in LLM_MODEL_API_KEY and it is used by the service it belongs
# to (gsk_… = Groq, sk-ant-… = Anthropic, anything else = OpenAI). A Groq key alone covers
# both voice (Whisper) and notes (gpt-oss).
LLM_MODEL_API_KEY=
#
# Or one variable per service. By default ("auto") each feature uses the first service with
# a key: voice OpenAI, then Groq; notes Anthropic, then OpenAI, then Groq (the service of
# LLM_MODEL_API_KEY always comes first).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
#
# Defaults (uncomment to change):
# AI_TRANSCRIBE_PROVIDER=auto        # auto | openai | groq | none
# AI_TRANSCRIBE_MODEL=               # default: gpt-transcribe (OpenAI), whisper-large-v3 (Groq)
# AI_NOTES_PROVIDER=auto             # auto | anthropic | openai | groq | none
# AI_NOTES_MODEL=                    # default: claude-sonnet-5-5, gpt-6.1-sol, openai/gpt-oss-120b
#                                    # cheaper: claude-haiku-5-5, gpt-6-luna, openai/gpt-oss-20b
# AI_DAILY_LIMIT=40                  # AI requests (recordings, notes, summaries) per user per day
# AI_REQUEST_TIMEOUT_SECONDS=120
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# ── Local AI instead of the cloud (not enabled yet) ─────────────────────────
# 1. Uncomment the `local` and `ollama` providers in
#    apps/server/src/modules/ai/providers/registry.ts (instructions are there).
# 2. Start a Whisper server (e.g. Speaches) and Ollama, then set:
# AI_TRANSCRIBE_PROVIDER=local
# LOCAL_WHISPER_BASE_URL=http://localhost:8000/v1
# AI_TRANSCRIBE_MODEL=Systran/faster-whisper-small
# AI_NOTES_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_NOTES_MODEL=qwen3:8b
# (From inside Docker, "localhost" is the container: use the host's address instead.)

# ── Optional ────────────────────────────────────────────────────────────────
# APP_ROLE=all                # all | api | worker (split scheduler into its own container)
# SCHEDULER_TICK_SECONDS=15
# NOTIFICATION_HORIZON_HOURS=36
# LOG_LEVEL=info
# APP_PORT=4000               # host port bound to 127.0.0.1

# ── Local development (npm run dev) ─────────────────────────────────────────
# PUBLIC_APP_URL=http://localhost:5173
# MONGODB_URI=mongodb://127.0.0.1:27017/buzzprep
# REGISTRATION_MODE=open
